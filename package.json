{
  "name": "castsnap",
  "version": "0.1.0",
  "private": true,
  "description": "Export a complete, verifiable, portable snapshot of one Farcaster account. See docs/SPEC.md.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "castsnap": "bin/castsnap.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "castsnap": "node bin/castsnap.js",
    "fields": "node scripts/fields-md.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@farcaster/core": "0.20.0",
    "@farcaster/hub-nodejs": "0.17.0",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
